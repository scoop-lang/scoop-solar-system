package dev.scoop.solar

internal struct BodyId(val naif: Int) : Equals<BodyId> {
    public override operator fun equals(other: BodyId): Boolean = naif == other.naif
}

internal class Body(
    val id: BodyId,
    val name: String,
    val english: String,
    val system: Int,
    val radius: Double,
    val periodDays: Double,
    val rotation: String,
    val kind: String,
    val description: String,
    val appearance: String,
    val texture: String
) {
    val moon: Boolean = id.naif > 100 && id.naif % 100 != 99
}

