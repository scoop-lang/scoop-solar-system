package dev.scoop.solar

import scoop.test.*
import scoop.math.*
import scoop.graphics.*

@Test
private class EphemerisTests {
    @Test
    fun JanuaryNewMoonKeepsPhysicalGeometryAcrossViews() {
        SolarModel()
            .use { model ->
                model.seek(model.ephemeris.parse("2027-01-07T10:05:08"))
                val overview = model.frame()
                val earth = overview.find(BodyId(399))
                val moon = overview.find(BodyId(301))
                // Independent Horizons geometric vectors at the reported UTC instant.
                val earthReference = Vector3(
                    -41759754.37375921,
                    141058751.6430394,
                    -8328.48389146477
                )
                val moonReference = Vector3(
                    -41676443.26690434,
                    140661437.3583194,
                    -31309.43844999373
                )
                assertTrue(earth.physical.position.subtract(earthReference).length() < 0.05)
                assertTrue(moon.physical.position.subtract(moonReference).length() < 0.05)
                val offset = moon.physical.position.subtract(earth.physical.position)
                assertTrue(offset.z < -22000.0)
                val shadowAxis = moon.physical.position.normalized()
                val moonToEarth = offset.multiply(-1.0)
                val miss = moonToEarth
                    .subtract(shadowAxis.multiply(moonToEarth.dot(shadowAxis)))
                    .length()
                assertTrue(miss > 40000.0 && miss < 40500.0)
                assertFalse(moon.visible)

                model.focus(BodyId(399))
                val local = model.frame()
                val localEarth = local.find(BodyId(399))
                val localMoon = local.find(BodyId(301))
                assertTrue(localMoon.visible)
                assertTrue(
                    localEarth.packet.physicalPosition.subtract(earth.physical.position).length() ==
                        0.0
                )
                assertTrue(
                    localMoon.packet.physicalPosition.subtract(moon.physical.position).length() ==
                        0.0
                )
                assertEquals(6371.0, localEarth.packet.physicalRadii.x)
                assertEquals(1737.4, localMoon.packet.physicalRadii.x)
                val displayDirection = localMoon
                    .packet
                    .position
                    .subtract(localEarth.packet.position)
                    .normalized()
                assertTrue(displayDirection.subtract(offset.normalized()).length() < 1e-10)
            }
    }

    @Test
    fun allSystemsCanBeFocusedAndSeekIsOrderIndependent() {
        SolarModel()
            .use { model ->
                model.seek(0.0)
                val initial = model.frame().find(BodyId(399)).physical.position
                val horizons = Vector3(-26499033.67743050, 144697296.7925493, -611.1494259536266)
                assertTrue(initial.subtract(horizons).length() < 0.01)
                for (body in model.catalog) {
                    model.focus(body.id)
                    val frame = model.frame()
                    assertTrue(frame.find(body.id).visible)
                    assertTrue(frame.find(body.id).physical.position.length().isFinite())
                    for (orbit in frame.orbits) {
                        assertEquals(257L, orbit.track.points.size)
                        assertTrue(orbit.track.points[0L].length().isFinite())
                    }
                }
                model.seek(model.ephemeris.maximum)
                model.frame()
                model.seek(model.ephemeris.minimum)
                model.frame()
                model.seek(0.0)
                val repeated = model.frame().find(BodyId(399)).physical.position
                assertEquals(initial.x, repeated.x)
                assertEquals(initial.y, repeated.y)
                assertEquals(initial.z, repeated.z)
            }
    }

    @Test
    fun CameraPanIsVisibleAndSurvivesTimeChanges() {
        SolarModel()
            .use { model ->
                model.seek(0.0)
                model.focus(BodyId(399), true)
                val size = Size(1280.0, 800.0)
                model.camera.pan(48.0, -24.0, size.height)
                for (et in [0.0, 86400.0, 2592000.0]) {
                    model.seek(et)
                    val frame = model.frame()
                    val earth = frame.find(BodyId(399))
                    val projected = project(
                        frame.camera,
                        earth.packet.position,
                        earth.packet.radii.x,
                        size
                    )!!
                    assertTrue(abs(projected.point.x - (size.width / 2.0 + 48.0)) < 1e-7)
                    assertTrue(abs(projected.point.y - (size.height / 2.0 - 24.0)) < 1e-7)
                }
            }
    }

    @Test
    fun PlutoAndCharonShareTheSameDisplayTransform() {
        SolarModel()
            .use { model ->
                model.seek(0.0)
                model.focus(BodyId(999))
                val frame = model.frame()
                val pluto = frame.find(BodyId(999))
                val charon = frame.find(BodyId(901))
                val expected = charon
                    .physical
                    .position
                    .subtract(pluto.physical.position)
                    .multiply(systemScale(9) / astronomicalUnit)
                val displayed = charon.packet.position.subtract(pluto.packet.position)
                assertTrue(expected.subtract(displayed).length() < 1e-12)
                val barycenter = model
                    .ephemeris
                    .state(BodyId(9), 0.0)
                    .position
                    .multiply(1.0 / astronomicalUnit)
                assertTrue(pluto.packet.position.subtract(barycenter).length() > 0.001)
                assertTrue(charon.packet.position.subtract(barycenter).length() > 0.02)
            }
    }
}
